# Vercel AI Gateway (Vercel 대시보드 → AI Gateway → API Keys 에서 발급)
#
# Vercel에 배포하면 VERCEL_OIDC_TOKEN이 자동 주입되므로 이 키 없이도 동작합니다.
# 로컬 개발(vercel dev)이나 다른 호스트에서만 필요합니다.
# 키를 만들 때 budget(예산 상한)을 함께 걸어 두세요.
AI_GATEWAY_API_KEY=

# 사용할 모델. 비우면 google/gemini-3.8-flash 를 씁니다.
# 이 작업은 추론 난이도가 낮고 응답 속도가 곧 체감 품질이라 flash 계열이면 충분합니다.
# 모델 목록: GET https://ai-gateway.vercel.sh/v1/models
GEMINI_MODEL=

# 게이트웨이 주소를 바꿔야 할 때만 설정합니다. 비우면 https://ai-gateway.vercel.sh/v1
AI_GATEWAY_BASE_URL=

# 한국관광공사 TourAPI (https://data.go.kr — "한국관광공사 국문 관광정보 서비스" 활용신청)
# 영업시간·휴무일을 받아오는 scripts/sync-hours.mjs 에서만 씁니다. 런타임에는 쓰지 않습니다.
# 개발계정은 일 1,000회 제한입니다.
TOURAPI_KEY=

# 프런트엔드를 아직 GitHub Pages에 두고 Vercel 함수만 호출하는 전환 기간에만 설정합니다.
# 쉼표로 구분된 정확한 Origin. 비워 두면 동일 출처만 허용합니다.
ALLOWED_ORIGIN=
