# RunYourAI 라우터 (agent.runyour.ai 콘솔에서 발급)
#
# 주의: 이 저장소를 만든 시점에 RunYourAI 라우터의 공개 개발자 문서를 찾지 못했습니다.
# api/recommend.js는 OpenAI 호환 POST {BASE_URL}/chat/completions 를 가정하고 있습니다.
# 콘솔에서 실제 엔드포인트와 인증 헤더를 확인한 뒤 값을 채우세요.
# 세 값이 모두 채워져야 라우터를 호출하고, 하나라도 비면 결정론적 로컬 추천으로 동작합니다.
RUNYOURAI_API_KEY=
RUNYOURAI_BASE_URL=
RUNYOURAI_MODEL=

# 프런트엔드를 아직 GitHub Pages에 두고 Vercel 함수만 호출하는 전환 기간에만 설정합니다.
# 쉼표로 구분된 정확한 Origin. 비워 두면 동일 출처만 허용합니다.
ALLOWED_ORIGIN=
